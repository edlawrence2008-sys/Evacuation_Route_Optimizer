; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Evacuation Route Optimizer"
config/description="SHS Final Capstone Project"
run/main_scene="res://scenes/menu/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false
boot_splash/use_filter=false

[audio]

buses/default_bus_layout="uid://dagd72wy2jgey"

[autoload]

GlobalData="*res://scripts/GlobalData.gd"
CrowdManager="*res://scripts/CrowdManager.gd"
EvacuationManager="*res://evacuation_manager.gd"
LogicNetwork="*res://scripts/logic/logic_network.gd"
PerformanceSettings="*res://scripts/performance_settings.gd"
MusicManager="*res://scripts/music_manager.gd"
SaveManager="*res://scripts/save_manager.gd"
DemoStore="*res://scripts/demo_store.gd"
SimRecorder="*res://scripts/sim_recorder.gd"
RuntimeExports="*res://scripts/runtime_exports.gd"
DemoPlayer="*res://scripts/demo_player.gd"
DemoComparer="*res://scripts/demo_comparer.gd"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/mode=2
window/stretch/mode="viewport"
mouse_cursor/custom_image="uid://q4uijdgfug2i"

[editor_plugins]

enabled=PackedStringArray("res://addons/crt/plugin.cfg", "res://addons/day_and_night_cycle/plugin.cfg")

[global_group]

Player=""
Members=""
Air_migration_nodes=""
EvacPoint=""
placeables=""

[gui]

theme/custom="uid://bqxe5gbsssjj2"

