config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Evacuation Route Optimizer"
run/main_scene="uid://bbtjdcwal7ax6"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/show_image=false

[audio]

buses/default_bus_layout="uid://dagd72wy2jgey"

[autoload]

GlobalData="*uid://cfbko60etcswu"
CrowdManager="*uid://d1mkuyh2drlok"
EvacuationManager="*uid://byoms34by2wh5"

[debug]

file_logging/enable_file_logging=true

[display]

window/size/mode=2
window/stretch/mode="viewport"
mouse_cursor/custom_image="uid://q4uijdgfug2i"

[editor_plugins]

enabled=PackedStringArray("res://addons/crt/plugin.cfg", "res://addons/day_and_night_cycle/plugin.cfg")

[global_group]

